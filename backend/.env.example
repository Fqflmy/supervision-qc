# 应用配置（复制为 .env 后按需修改；环境变量前缀 SUPERVISION_）
# 重要：本文件必须保存为 UTF-8 无 BOM，且位于 backend/ 目录下，
# 否则配置会被静默忽略、全部回退到默认值（表现为「填了 Key 也不生效」）。
# ---- 数据库 ----
SUPERVISION_DATABASE_URL=postgresql+psycopg://supervision:supervision@127.0.0.1:5432/supervision
# ---- Neo4j ----
SUPERVISION_NEO4J_URI=bolt://127.0.0.1:7687
SUPERVISION_NEO4J_USER=neo4j
SUPERVISION_NEO4J_PASSWORD=supervision123
# ---- Redis ----
SUPERVISION_REDIS_URL=redis://127.0.0.1:6379/0
# ---- 大模型（DeepSeek 主，Qwen 备）----
SUPERVISION_LLM_PROVIDER=openai_compatible
SUPERVISION_LLM_PRIMARY_MODEL=deepseek-chat
SUPERVISION_LLM_PRIMARY_BASE_URL=https://api.deepseek.com/v1
SUPERVISION_LLM_PRIMARY_API_KEY=
SUPERVISION_LLM_FALLBACK_MODEL=qwen-plus
SUPERVISION_LLM_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SUPERVISION_LLM_FALLBACK_API_KEY=
# ---- Embedding / Reranker ----
# provider 可选值：
#   siliconflow = 硅基流动托管服务（推荐：无需本地权重、启动快、精度与本地一致）
#   local       = 本地 BGE 权重（需放到 var/models/ 下，缺失时自动降级并告警）
#   http        = 自建推理服务（Compose 中的 embedding / reranker 容器）
#   hash / score_fusion = 无模型降级实现（离线可跑，精度有限，仅用于演示）
SUPERVISION_EMBEDDING_PROVIDER=siliconflow
SUPERVISION_EMBEDDING_MODEL=BAAI/bge-m3
SUPERVISION_EMBEDDING_API_BASE_URL=https://api.siliconflow.cn/v1
SUPERVISION_EMBEDDING_API_KEY=
SUPERVISION_RERANKER_PROVIDER=siliconflow
SUPERVISION_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
SUPERVISION_RERANKER_API_BASE_URL=https://api.siliconflow.cn/v1
SUPERVISION_RERANKER_API_KEY=
# 本地模式（provider=local）专用
# SUPERVISION_EMBEDDING_DEVICE=cpu
# SUPERVISION_RERANKER_DEVICE=cpu
# ---- 安全 ----
SUPERVISION_JWT_SECRET=please-change-this-secret-in-production
# ---- 日志 ----
SUPERVISION_LOG_LEVEL=INFO
SUPERVISION_LOG_JSON=true
