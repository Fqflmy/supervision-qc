# 环境变量模板：复制为 deploy/.env 后按需修改
# docker compose -f docker-compose.yml up -d

# ---- 数据层 ----
POSTGRES_USER=supervision
POSTGRES_PASSWORD=supervision
POSTGRES_DB=supervision
NEO4J_PASSWORD=supervision123
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
STORAGE_BACKEND=local

# ---- 大模型（必填：至少配置一个 Key）----
LLM_PROVIDER=openai_compatible
LLM_PRIMARY_MODEL=deepseek-chat
LLM_PRIMARY_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
LLM_FALLBACK_MODEL=qwen-plus
LLM_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=

# ---- 检索模型服务 ----
# siliconflow = 硅基流动托管服务（推荐：无需本地 GPU/权重，启动快）
# http        = 使用 compose 内的 embedding/reranker 容器（本地推理，需下载权重）
# hash / score_fusion = 无模型降级（离线演示，精度有限）
EMBEDDING_PROVIDER=siliconflow
RERANKER_PROVIDER=siliconflow
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# provider=siliconflow 时必填（Embedding 与 Reranker 共用同一个 Key）
SILICONFLOW_API_KEY=
# provider=http 时生效（容器内地址由 compose 注入，一般无需修改）
EMBEDDING_API_BASE_URL=https://api.siliconflow.cn/v1
RERANKER_API_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_DEVICE=cpu
RERANKER_DEVICE=cpu
HF_ENDPOINT=https://hf-mirror.com

# 表结构管理方式：auto（生产走 alembic 迁移）/ alembic / create_all
# 正式环境务必用 alembic，否则改表结构会静默失效（create_all 不处理列变更）
DB_SCHEMA_MODE=auto
# ---- 其他 ----
# 运行环境：设为 production 会启用强制安全校验（JWT 密钥占位/过短将拒绝启动）
ENVIRONMENT=dev
# 登录令牌签名密钥。留空时开发环境自动生成随机值（重启后令牌失效）；
# 生产环境（ENVIRONMENT=production）必须显式设置长度 >= 32 的随机串，
# 否则服务拒绝启动 —— 该密钥泄漏会导致任何人都能伪造令牌绕过鉴权。
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# 默认管理员：上线前建议 SEED_DEFAULT_ADMIN=false，或把密码改为强密码
# （Admin@12345 已公开在仓库文档中，仅适用于开发/演示）
SEED_DEFAULT_ADMIN=true
SEED_DEFAULT_ADMIN_PASSWORD=Admin@12345
FORCE_PASSWORD_CHANGE_ON_FIRST_LOGIN=false
GRAFANA_PASSWORD=admin
WEB_PORT=8080
# ---- 可观测性 ----
# 监控面板端口（仅绑本机时写成 127.0.0.1:9090:9090）
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Prometheus 抓取 /metrics 用的 Bearer 令牌，与 api 容器的
# SUPERVISION_METRICS_BEARER_TOKEN 同源（都取自本文件）。
# 留空时：
#   - 非生产环境：允许匿名抓取（开箱即用，面板立刻有数据）
#   - 生产环境  ：拒绝抓取（面板无数据），必须在启动日志提示下设置本项
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(32))"
METRICS_BEARER_TOKEN=

# 是否允许匿名抓取 /metrics（仅内网/开发）。设 true 会覆盖上面的令牌校验。
METRICS_PUBLIC=false
# ---- 链路追踪（LangSmith）----
# 留空即自动关闭追踪，功能不受影响（追踪是增强能力，不该阻止启动）。
# 获取地址：https://smith.langchain.com -> Settings -> API Keys
LANGSMITH_API_KEY=
# 追踪数据归属的项目名（控制台中的 Project，首次上报会自动创建）
LANGSMITH_PROJECT=supervision-qc
# 总开关
LANGSMITH_TRACING=true
# 是否采集提示词与文档正文。
# 工程资料含敏感信息（涉密图纸说明、企业内部资料）时设为 false：
# 只上报形状（长度/条数/模型名），仍能看到耗时与 Token，但不落正文。
LANGSMITH_CAPTURE_CONTENT=true


